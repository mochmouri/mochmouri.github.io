---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Contact from '../../components/Contact.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title="Projects — Mustapha El Chmouri"
  description="Personal and side projects."
>
  <Nav />
  <main class="page-main">
    <div class="container">
      <section class="section">
        <span class="section-label">Projects</span>

        <div class="projects-grid">
          {projects.map((project) => (
            <a href={`/projects/${project.slug}`} class="project-card">
              <div class={`card-thumb${project.data.thumbnail ? ' card-thumb--filled' : ''}`}>
                {project.data.thumbnail
                  ? <img src={project.data.thumbnail} alt={project.data.title} class="thumb-img" />
                  : <span class="thumb-label">{project.data.type}</span>
                }
              </div>
              <div class="card-body">
                <span class="project-type">{project.data.type}</span>
                <h2 class="project-title">{project.data.title}</h2>
                {project.data.status === 'work-in-progress' && (
                  <span class="wip-badge">Work in progress</span>
                )}
                <p class="project-desc">{project.data.description}</p>
                <span class="read-more">Read more →</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Contact />
</Layout>

<style>
  .page-main {
    padding-top: var(--nav-h);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .project-card:hover {
    border-color: var(--border-light);
    transform: translateY(-2px);
  }

  .card-thumb {
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, #111 0%, #1a1a1a 50%, #0f0f1a 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .card-thumb::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.4;
  }

  .card-thumb--filled::before {
    display: none;
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .thumb-label {
    position: relative;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border-light);
    padding: 0.3em 0.7em;
    border-radius: 2px;
    background: rgba(0,0,0,0.4);
  }

  .card-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-type {
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .project-title {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .wip-badge {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border-light);
    padding: 0.2em 0.55em;
    border-radius: 2px;
    margin-bottom: 0.75rem;
    width: fit-content;
  }

  .project-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.7;
    flex: 1;
    margin-bottom: 1.25rem;
  }

  .read-more {
    font-size: 0.78rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .project-card:hover .read-more {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
