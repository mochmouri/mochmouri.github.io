---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout
  title="CV — Mustapha El Chmouri"
  description="Curriculum vitae — view online or download as PDF."
>
  <Nav />
  <main class="page-main">
    <div class="container">
      <section class="section">
        <div class="cv-header">
          <div>
            <span class="section-label">Curriculum Vitae</span>
            <h1 class="cv-title">Mustapha El Chmouri</h1>
          </div>
          <a href="/cv.pdf" download class="download-btn">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download PDF
          </a>
        </div>

        <div class="cv-viewer">
          <object
            data="/cv.pdf"
            type="application/pdf"
            class="pdf-embed"
            aria-label="CV PDF"
          >
            <div class="pdf-fallback">
              <p>Your browser cannot display the PDF inline.</p>
              <a href="/cv.pdf" download class="download-btn">Download CV</a>
            </div>
          </object>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .page-main {
    padding-top: var(--nav-h);
  }

  .cv-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cv-title {
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--text);
    letter-spacing: -0.02em;
    margin-top: 0.5rem;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--accent);
    color: #111;
    border-radius: 2px;
    transition: background 0.15s;
  }

  .download-btn:hover {
    background: var(--accent-hover);
  }

  .cv-viewer {
    border: 1px solid var(--border);
    border-radius: 3px;
    overflow: hidden;
  }

  .pdf-embed {
    width: 100%;
    height: 85vh;
    min-height: 600px;
    display: block;
  }

  .pdf-fallback {
    padding: 3rem;
    text-align: center;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .pdf-fallback p {
    font-size: 0.9rem;
  }
</style>
